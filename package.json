{
  "name": "sanity-plugin-variant-picker",
  "version": "0.2.0",
  "description": "A Sanity Studio string field with a searchable popover over its options.list.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "string",
    "options-list",
    "picker"
  ],
  "homepage": "https://github.com/dennisregalado/sanity-plugin-variant-picker#readme",
  "bugs": {
    "url": "https://github.com/dennisregalado/sanity-plugin-variant-picker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisregalado/sanity-plugin-variant-picker.git"
  },
  "license": "MIT",
  "author": "Dennis Regalado <dennis@baggy.studio>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "browserslist": "extends @sanity/browserslist-config",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "devDependencies": {
    "@sanity/icons": "^5.3.0",
    "@sanity/pkg-utils": "^10.7.2",
    "@sanity/plugin-kit": "^6.0.0",
    "@sanity/ui": "^4.4.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "ajv": "^8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^6.23.0",
    "styled-components": "^6.4.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@sanity/icons": "^5",
    "@sanity/ui": "^4",
    "react": "^18 || ^19",
    "sanity": "^6"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false
    }
  }
}
